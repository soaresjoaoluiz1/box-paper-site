# =============================================================
# Box Paper Embalagens — Apache .htaccess
# =============================================================

# ----- Force HTTPS -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove www (canonical → boxpaperembalagens.com.br)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # Pretty URL: /obrigado → obrigado.html
  RewriteRule ^obrigado/?$ obrigado.html [L]
</IfModule>

# ----- Gzip Compression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/ld+json image/svg+xml font/ttf font/otf
</IfModule>

# ----- Browser Cache (Expires) -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — curto pra invalidar updates rápido
  ExpiresByType text/html                     "access plus 1 hour"

  # CSS / JS — 1 mês
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"
  ExpiresByType text/javascript               "access plus 1 month"

  # Imagens — 1 ano
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"

  # Fontes — 1 ano
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"

  # Manifest / robots / sitemap — 1 dia
  ExpiresByType application/manifest+json     "access plus 1 day"
  ExpiresByType application/xml               "access plus 1 day"
  ExpiresByType text/xml                      "access plus 1 day"
</IfModule>

# ----- Cache-Control Headers -----
<IfModule mod_headers.c>
  # Imagens, fontes, CSS, JS — immutable
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>

  # ----- Security Headers -----
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ----- Custom Error Pages -----
ErrorDocument 404 /index.html

# ----- Block access to dev/build artifacts -----
<FilesMatch "^(\.git|\.gitignore|\.env|package\.json|README\.md)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteRule ^_scripts/ - [F,L]
  RewriteRule ^_source-images/ - [F,L]
  RewriteRule ^\.git/ - [F,L]
</IfModule>

# ----- MIME Types -----
<IfModule mod_mime.c>
  AddType application/manifest+json    .webmanifest
  AddType application/ld+json           .jsonld
  AddType image/svg+xml                 .svg .svgz
  AddType font/woff                     .woff
  AddType font/woff2                    .woff2
  AddType application/xml               .xml
</IfModule>

# ----- Disable directory listing -----
Options -Indexes
